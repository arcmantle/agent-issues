{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"vite": ["../../packages/site/node_modules/vite"],
			"lit": ["../../packages/site/node_modules/lit"],
			"lit/*": ["../../packages/site/node_modules/lit/*"],
			"lucide": ["../../packages/site/node_modules/lucide"]
		}
	},
	"include": ["*.ts", "components/**/*.ts"]
}
