{
	"name": "agent-issues",
	"version": "0.1.0",
	"description": "CLI for managing initiatives, PRDs, user stories, ADRs, and issues.",
	"type": "module",
	"bin": {
		"agent-issues": "./dist/cli.js"
	},
	"files": [
		"dist",
		"site/dist",
		"kanban/dist",
		".github/agents",
		".github/hooks",
		"skills"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node ./scripts/build.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@agent-issues/api-pg": "workspace:*",
		"@agent-issues/api-local": "workspace:*",
		"@agent-issues/core": "workspace:*",
		"@azure/msal-node": "catalog:",
		"@babel/parser": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"@types/node": "catalog:",
		"clipanion": "catalog:",
		"esbuild": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"dependencies": {
		"better-sqlite3": "catalog:"
	}
}