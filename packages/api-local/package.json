{
	"name": "@agent-issues/api-local",
	"version": "0.1.0",
	"private": true,
	"description": "Local SQLite storage engine and daemon JSON-RPC server (the local mirror of @agent-issues/api's cloud Postgres service).",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
		"postbuild": "node --eval \"import { writeBuildInfoFile } from './dist/build-info.js'; writeBuildInfoFile('dist');\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.9.2",
		"@types/supertest": "^7.2.0",
		"supertest": "^7.2.2",
		"typescript": "^7.0.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@agent-issues/core": "workspace:*",
		"better-sqlite3": "^12.10.0",
		"drizzle-orm": "^0.45.2",
		"fuse.js": "^7.4.2"
	}
}
